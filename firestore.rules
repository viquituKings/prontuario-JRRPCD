rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita na coleção de pacientes e subcoleções de evoluções
    match /pacientes/{pacienteId} {
      allow read, write: if true; // Em produção, configure: allow read, write: if request.auth != null;
      
      match /evolucoes/{evolucaoId} {
        allow read, write: if true;
      }
    }

    // Configurações do sistema
    match /configuracoes/{document=**} {
      allow read, write: if true;
    }
  }
}

